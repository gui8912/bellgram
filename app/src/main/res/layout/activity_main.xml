<?xml version="1.0" encoding="utf-8"?>
<!--
  modified: v4.3.0 界面美化 —— 标题区改为「新图标 + 应用名」横向品牌行、加强调短线，
  卡片/状态条/按钮的配色统一改用语义色以同时适配明亮与暗色主题。
  所有原有控件 id 与类型保持不变：ui_layout / user_message_layout /
  contact_input_layout / contact_value / message_value / trigger / clear 等。
  modified: v4.4.0 起 clear 按钮从首页移除，「清除配置」迁入应用设置页并加二次确认；
  两个文字入口统一限制单行，避免长文案折行把这一行按钮撑成两行。
  modified: v4.5.2 首屏收成「一页、不用下拉」：
    【删除】标题区简介 TextView（R.id.tagline / @string/app_tagline）
           去向：这段「收到含关键词的短信时……」不再展示；应用用途由引导页与
           README 说明，两份 strings.xml 里的对应文案一并移除，不留死资源。
    【删除】底部「红米 / HyperOS 必做四步」提示（R.id.permission_tip）
           去向：权限体检的完整入口仍在设置页 permission_check_key；首页的
           「点一下直接体检」能力迁到状态条，见 MainActivity#bindStatusPermissionEntry。
    【删除】最下方品牌图标（R.id.brand_icon）：纯装饰，删掉后不再需要底部留白。
    【修改】压缩 padding / margin 与图标、按钮尺寸，常态内容高度小于可视区，
           整页一屏显示；标题行去掉只剩一个控件的内层 LinearLayout。
    【保留】外层 ScrollView 只作软键盘弹出与极小屏幕的兜底 ——
           否则输入关键词时键盘会盖住「启用提醒」按钮，反而更不好用。
           常态下不出现滚动：scrollbars=none + overScrollMode=never。
  功能控件 id 与类型一个未动：ui_layout / user_message_layout / status_text /
  contact_input_layout / contact_value / message_value / trigger /
  practice_rule / reminder_settings / headline。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/user_message_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".MainActivity">

    <!-- modified: v4.5.2 保留滚动容器仅为键盘/小屏兜底，常态一屏不滚动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <!-- 根容器先拿焦点，避免横竖屏切换时输入法自动弹出 -->
        <LinearLayout
            android:id="@+id/ui_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusableInTouchMode="true"
            android:descendantFocusability="beforeDescendants"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <!-- ===== 标题区：品牌图标 + 应用名（modified: v4.5.2 去掉简介、缩小图标） ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/logo"
                    android:src="@drawable/app_logo" />

                <!-- modified: v4.5.2 【删除】原内层 LinearLayout 与 R.id.tagline；
                     只剩 headline 一个控件，直接平铺即可，标题行由约 71dp 降到 40dp。 -->
                <TextView
                    android:id="@+id/headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- modified: 标题下的强调色短线（v4.5.2 间距 14dp -> 10dp） -->
            <View
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_accent_line" />

            <!-- ===== 规则卡片（modified: v4.5.2 外边距 18->12、内边距 18->12） ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/contact_name"
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_the_contact_name" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/contact_input_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/contact_value"
                    android:textColorHint="@color/text_secondary"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/accent_color"
                    app:counterEnabled="true"
                    app:counterMaxLength="15"
                    app:endIconMode="clear_text"
                    app:endIconTint="@color/accent_color"
                    app:helperText="@string/contact_helper"
                    app:helperTextTextColor="@color/text_secondary"
                    app:hintTextColor="@color/accent_color">

                    <AutoCompleteTextView
                        android:id="@+id/contact_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/message_string"
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/message_string" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/message_hint"
                    android:textColorHint="@color/text_secondary"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/accent_color"
                    app:counterEnabled="true"
                    app:counterMaxLength="50"
                    app:endIconMode="clear_text"
                    app:endIconTint="@color/accent_color"
                    app:helperText="@string/helper_text_keyword"
                    app:helperTextTextColor="@color/text_secondary"
                    app:hintTextColor="@color/accent_color">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/message_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===== 状态条：当前是否在监听 =====
                 modified: v4.5.2 外边距 16->10、内边距 14->10；
                 同时接管原底部清单的「点击直达权限体检」能力（见 MainActivity）。 -->
            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_status_idle"
                android:lineSpacingExtra="2dp"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/status_idle"
                android:textColor="@color/status_idle_text"
                android:textSize="14sp" />

            <!-- ===== 操作按钮（modified: v4.5.2 外边距 18->12、高度 56->52） ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/trigger"
                style="@style/PrimaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/trigger_button"
                app:icon="@drawable/ic_bell_24"
                app:iconGravity="textStart"
                app:iconTint="@color/on_accent_text" />

            <!-- modified: v4.4.0 【删除】原首页「清除配置」大按钮（R.id.clear）。
                 去向：功能迁入 app_preferences.xml 的 clear_config_key 入口，
                 由 SettingsActivity 弹确认框后才执行 AppConfig.clear()，避免误触丢配置。 -->

            <!-- 二次开发新增：两个直达入口。
                 · 「规则演练」借鉴短信铃铛：先验证再依赖，避免关键词写错却毫无察觉；
                 · 「提醒方式」把响铃/震动/重复策略放到一手可点的地方，
                   而不是只藏在右上角菜单里（v4.4.0 起文案缩短为单行）。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/practice_rule"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/practice_button"
                    android:textColor="@color/accent_color"
                    app:icon="@drawable/ic_tune_24"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent_color" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reminder_settings"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="38dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/reminder_settings_button"
                    android:textColor="@color/accent_color"
                    app:icon="@drawable/ic_baseline_settings_24"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent_color" />
            </LinearLayout>

            <!-- modified: v4.5.2 【删除】底部「红米 / HyperOS 必做四步」提示
                 （R.id.permission_tip / @string/permission_tip）。
                 去向：权限体检完整入口在设置页 permission_check_key；
                 首页「点一下就体检」的快捷能力改挂 status_text，
                 见 MainActivity#bindStatusPermissionEntry，功能本身未删。 -->

            <!-- modified: v4.5.2 【删除】最下方装饰性品牌图标（R.id.brand_icon）。
                 去向：纯装饰、无点击逻辑，整块移除，不再需要底部 72dp + 18dp 留白。 -->
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
