<?xml version="1.0" encoding="utf-8"?>
<!-- modified: v4.3.0 所有主题 parent 从 Light.*.Bridge 换成 DayNight 系，配合 values-night/
     colors.xml + values-night/bools.xml 实现明亮/暗色两套主题；系统栏图标明暗统一由
     @bool/light_system_bars 决定，EdgeToEdgeHelper 用同一个开关设置 appearance。 -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- modified: v4.5.3 【删除】零引用样式 MyTextViewStyle /
         SecondaryButtonStyle（定义后从未被 @style 或主题 item 引用）。 -->
    <!-- custom theme for entire app -->
    <!-- modified: DayNight 父主题 + 系统栏配色/图标明暗 -->
    <style name="MyAppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- primary color for app bar, UI elements(material design) -->
        <item name="colorPrimary">@color/primaryColor</item>
        <!-- dark color for status bar -->
         <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <!-- color used for edit text and other views in highlighted/ focused state -->
        <item name="colorAccent">@color/secondaryLightColor</item>
        <!-- custom style for button-->
        <item name="buttonStyle">@style/MyButtonViewStyle</item>
        <!-- 纯色浅灰底 + 白色卡片（暗色下由 values-night 覆盖同名色） -->
        <item name="android:windowBackground">@color/surface_bg</item>
        <!-- modified: 双主题下的系统栏 -->
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:navigationBarColor">@color/surface_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <!-- custom snackbar styling -->
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
        <!-- adjust colors of edit text when used and in normal state-->
        <item name="colorControlNormal">@color/primaryLightColor</item>
        <item name="colorControlActivated">@color/accent_color</item>
        <item name="android:textColorHighlight">@color/secondaryColor</item>
    </style>
    <!-- splash drawable to be applied as splash window, before activity shows up -->
    <style name="MyAppTheme.Splash">
        <item name="android:windowBackground">@drawable/splash_drawable</item>
    </style>
    <!-- modified: v4.5.3 【删除】原「custom style for textView」注释：
         它描述的是已删的 MyTextViewStyle，留着会指向不存在的样式。 -->

    <!-- custom style for Button -->
    <style name="MyButtonViewStyle" parent="Widget.AppCompat.Button">
        <!-- assign a gradient(somewhat red and blue) background to a button -->
          <item name="android:background">@drawable/rounded_button_gradient</item>
        <!-- white text color to button text -->
          <item name="android:textColor">@color/on_accent_text</item>
        <!-- make the button to pop-up -->
          <item name="android:elevation">30dp</item>
    </style>

    <!-- snackbar customization material theming -->
    <style name="Widget.App.Snackbar" parent="Widget.MaterialComponents.Snackbar.FullWidth">
        <item name="android:background">@drawable/snackbar_shape</item>
        <item name="elevation">20dp</item>
    </style>

    <!-- Dialog customization -->
    <!-- modified: DayNight 对话框 + 卡片背景，避免暗色主题下弹白框 -->
    <style name="MyDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@color/card_bg</item>
        <item name="colorAccent">@color/accent_color</item>
    </style>

    <!-- Theme used primarily for FTI setup / Onboarding screen -->
    <!-- modified: 去掉写死的 #680000，改用可跟随主题的资源 -->
    <style name="OnboardingTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/somewhat_red</item>
        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorAccent">@color/lightPinkColor</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:colorControlHighlight">@color/lightGreenColor</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>

    <!-- material themed preferences for settings screen -->
    <style name="AppSettingsTheme" parent="MyAppTheme">
        <item name="colorAccent">@color/accent_color</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>


    <!-- ===== 二次开发新增：重做界面用的样式 ===== -->

    <!-- 输入区块的小标题 -->
    <style name="SectionTitle" parent="android:Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- 主按钮：实心、圆角、加粗 -->
    <!-- modified: 背景/文字改用语义色，暗色主题下仍保持足够对比度 -->
    <style name="PrimaryButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_accent_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- modified: v4.5.3 【删除】原「次要按钮：描边、无填充」及其配色注释：
         描述的是已删的 SecondaryButtonStyle（首页两个文字入口直接用
         Widget.MaterialComponents.Button.TextButton，从未用过这个样式）。 -->
    <!-- 二次开发新增（借鉴短信铃铛）：全屏告警页主题。
         modified: 改用 DayNight 父主题，告警页也跟随明亮/暗色两套配色；
         锁屏拉起时仍是 NoActionBar，不出现不协调的顶部条。 -->
    <style name="AlertTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/alert_bg</item>
        <item name="android:statusBarColor">@color/alert_bg</item>
        <item name="android:navigationBarColor">@color/alert_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>

    <!-- 告警页主按钮：整屏最醒目的元素，必须一眼可点 -->
    <!-- modified: 红底按钮文字恒为白色，不随亮/暗主题反转 -->
    <style name="AlertStopButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/alert_accent</item>
        <item name="android:textColor">@color/on_accent_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 告警页次按钮：稍后提醒 -->
    <style name="AlertSnoozeButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/alert_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/alert_text_secondary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
