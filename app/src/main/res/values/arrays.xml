    <string-array name="volume_key_action_entries">
        <item>Do nothing (buttons still adjust volume)</item>
        <item>Snooze</item>
        <item>Stop</item>
    </string-array>
    <string-array name="volume_key_action_values">
        <item>none</item>
        <item>snooze</item>
        <item>stop</item>
    </string-array>
