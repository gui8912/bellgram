<?xml version="1.0" encoding="utf-8"?>
<!-- modified: v4.3.0 追加主题/音量/贪睡/音量键数组，并为三个数值项加「Custom…」入口。
     原有选项与默认值一个未动，Custom 只是触发输入对话框的哨兵值，不会写入配置。 -->
<resources>
    <string-array name="ring_duration_entries">
        <item>Until I stop it</item>
        <item>30 seconds</item>
        <item>60 seconds</item>
        <item>2 minutes</item>
        <item>Custom…</item>
    </string-array>
    <string-array name="ring_duration_values">
        <item>0</item>
        <item>30</item>
        <item>60</item>
        <item>120</item>
        <item>custom</item>
    </string-array>

    <string-array name="repeat_interval_entries">
        <item>Do not repeat</item>
        <item>1 minute</item>
        <item>3 minutes</item>
        <item>5 minutes</item>
        <item>10 minutes</item>
        <item>Custom…</item>
    </string-array>
    <string-array name="repeat_interval_values">
        <item>0</item>
        <item>1</item>
        <item>3</item>
        <item>5</item>
        <item>10</item>
        <item>custom</item>
    </string-array>

    <string-array name="max_repeat_entries">
        <item>Until I stop it</item>
        <item>1 time</item>
        <item>3 times</item>
        <item>5 times</item>
        <item>10 times</item>
        <item>Custom…</item>
    </string-array>
    <string-array name="max_repeat_values">
        <item>0</item>
        <item>1</item>
        <item>3</item>
        <item>5</item>
        <item>10</item>
        <item>custom</item>
    </string-array>
    <string-array name="quiet_hours_entries">
        <item>Off</item>
        <item>21:00–07:00</item>
        <item>22:00–07:00</item>
        <item>23:00–08:00</item>
        <item>00:00–06:00</item>
    </string-array>
    <string-array name="quiet_hours_values">
        <item>off</item>
        <item>21-7</item>
        <item>22-7</item>
        <item>23-8</item>
        <item>0-6</item>
    </string-array>

    <!-- modified: 明亮 / 暗色 / 跟随系统 -->
    <string-array name="theme_mode_entries">
        <item>Follow system</item>
        <item>Light</item>
        <item>Dark</item>
    </string-array>
    <string-array name="theme_mode_values">
        <item>system</item>
        <item>light</item>
        <item>dark</item>
    </string-array>

    <!-- modified: 闹钟音量档位；0 = 跟随系统、不改动任何系统设置 -->
    <string-array name="alarm_volume_entries">
        <item>Follow system (no change)</item>
        <item>40%</item>
        <item>60%</item>
        <item>80% (recommended)</item>
        <item>100% (previous behaviour)</item>
    </string-array>
    <string-array name="alarm_volume_values">
        <item>0</item>
        <item>40</item>
        <item>60</item>
        <item>80</item>
        <item>100</item>
    </string-array>

    <!-- modified: 参考系统时钟「贪睡时长」 -->
    <string-array name="snooze_minutes_entries">
        <item>1 minute</item>
        <item>3 minutes</item>
        <item>5 minutes</item>
        <item>10 minutes</item>
        <item>15 minutes</item>
