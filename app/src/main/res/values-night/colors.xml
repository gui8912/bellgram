<?xml version="1.0" encoding="utf-8"?>
<!-- modified: v4.3.0 暗色主题专用色板。只覆盖语义色，键名与 values/colors.xml 一一对应，
     Java 侧仍用 R.color.xxx 引用，无需改代码即可整体换肤。 -->
<resources>
    <!-- 品牌色：暗色下 ActionBar 用深蓝，强调控件用亮蓝 -->
    <color name="primaryColor">#1E2A44</color>
    <color name="primaryLightColor">#8AB4FF</color>
    <color name="primaryDarkColor">#0E1420</color>
    <color name="secondaryColor">#8AB4FF</color>
    <color name="secondaryLightColor">#B6D4FF</color>
    <color name="secondaryDarkColor">#8AB4FF</color>
    <color name="primaryTextColor">#FFFFFF</color>
    <color name="secondaryTextColor">#A7B4C7</color>
    <color name="app_logo_background">#182233</color>

    <!-- 引导页点/文字：暗底上改用更亮、更柔和的同色系 -->
    <color name="lightBlueColor">#7FD4FF</color>
    <color name="lightOrangeColor">#FFC45C</color>
    <color name="lightPinkColor">#FF9BB8</color>
    <color name="lightGreenColor">#B9F6CA</color>

    <!-- 中性表面色 -->
    <color name="surface_bg">#0E1420</color>
    <color name="card_bg">#182233</color>
    <color name="card_stroke">#2A3A52</color>
    <color name="text_primary">#EAF0FA</color>
