    <color name="alert_surface">#16202E</color>
    <color name="alert_text_primary">#FFFFFF</color>
    <color name="alert_text_secondary">#B6C2D2</color>
    <color name="alert_accent">#FF6B6F</color>

    <!-- 语义附加色 -->
    <color name="accent_color">#8AB4FF</color>
