<?xml version="1.0" encoding="utf-8"?>
<!-- modified: v4.3.0 设置页重排 —— 新增外观主题、闹钟音量档位、渐强音量、
     稍后提醒时长、音量键行为；响铃时长/间隔/次数保留原默认值并支持「自定义…」手动输入。
     参考 Google Clock / MIUI 时钟 / Alarm Clock Xtreme 的设置项组织方式。
     modified: v4.4.0 —— 下方 ListPreference 的 android:dialogMessage 只作为提示数据源，
     由 SettingsActivity 自绘弹窗读取；AndroidX DialogPreference 官方文档明确标注该属性
     「与列表型对话框冲突（conflicts with list-based dialogs）」，若交给框架默认对话框渲染，
     就会出现「只剩一段提示、看不到任何可选项」。另新增「清除配置」入口
     （clear_config_key），点击后必须经二次确认才执行。
     modified: v4.5.0 —— 8 个下拉项改用 SelfDrawnListPreference 而不是 ListPreference。
     原因：androidx.preference 1.2.1 的 Preference.performClick() 先执行 onClick()
     （DialogPreference 里已经提交了框架 DialogFragment），再回调 OnPreferenceClickListener，
     监听器返回 true 拦不住那个已经提交的弹窗 —— v4.4.0 只挂监听器，实际会叠出两个对话框。
     SelfDrawnListPreference 把 onClick() 置空，框架不再提交弹窗，只保留应用自绘的那一个。
     另新增「试响一次」入口（preview_alert_key），按当前设置播一轮但不建立会话。
     modified: v4.6.0 —— 新增「提醒铃声」入口（custom_ringtone_key），
     放在「试响一次」正上方，选完铃声立刻能试听；persistent=false，值由
     CustomRingtone 保存在应用私有文件与默认 SharedPreferences 里，
     不走 Preference 自己的持久化，避免把音频 Uri 写进 preference 树。 -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_button">

    <!-- 权限体检入口：targetSdk 36 下能否响铃取决于多项系统开关，放在最上方便于自查 -->
    <Preference
        android:icon="@drawable/ic_shield_24"
        android:key="@string/permission_check_key"
        android:title="@string/permission_check_title"
        android:summary="@string/permission_check_summary"
        android:persistent="false" />

    <!-- 【新增 v4.5.6】排障三件套：权限体检 → 接收诊断 → 模拟短信。
         用户报「收到关键词短信却完全没反应」时，靠这三步可自行定位到具体环节。 -->
    <Preference
        android:icon="@drawable/ic_tune_24"
        android:key="@string/sms_trace_key"
        android:title="@string/sms_trace_title"
        android:summary="@string/sms_trace_summary"
        android:persistent="false" />

    <Preference
        android:icon="@drawable/ic_bell_24"
        android:key="@string/send_test_sms_key"
        android:title="@string/send_test_sms_title"
        android:summary="@string/send_test_sms_summary"
        android:persistent="false" />

    <!-- 外观 -->
    <!-- modified: 新增外观分组 -->
    <PreferenceCategory
        android:title="@string/pref_category_appearance"
        android:key="@string/pref_category_appearance_key">

        <!-- modified: 明亮 / 暗色 / 跟随系统 -->
        <com.saiga.find.messagefinder.SelfDrawnListPreference
            android:icon="@drawable/ic_palette_24"
            android:key="@string/theme_mode_key"
            android:title="@string/theme_mode_title"
            android:dialogTitle="@string/theme_mode_title"
            android:entries="@array/theme_mode_entries"
            android:entryValues="@array/theme_mode_values"
            android:defaultValue="system"
            android:summary="%s" />
    </PreferenceCategory>

    <!-- 提醒方式 -->
    <PreferenceCategory
        android:title="@string/pref_category_reminder"
        android:key="@string/pref_category_reminder_key">

        <!-- modified: 借鉴 SmsForwarder「转发功能总开关」，一键暂停全部提醒 -->
        <SwitchPreferenceCompat
            android:icon="@drawable/ic_bell_24"
            android:key="@string/alert_enabled_key"
            android:title="@string/alert_enabled_title"
            android:defaultValue="true"
            android:summaryOn="@string/alert_enabled_on"
            android:summaryOff="@string/alert_enabled_off" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_bell_24"
            android:key="@string/ring_enabled_key"
            android:title="@string/ring_enabled"
            android:defaultValue="true"
            android:summaryOn="@string/ring_enabled_on"
            android:summaryOff="@string/ring_enabled_off" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_vibrate_24"
            android:key="@string/vibrate_enabled_key"
            android:title="@string/vibrate_enabled"
            android:defaultValue="true"
            android:summaryOn="@string/vibrate_enabled_on"
            android:summaryOff="@string/vibrate_enabled_off" />

        <!-- modified: 不再强制最大音量，改为可选档位；0 = 跟随系统、完全不改系统设置 -->
        <com.saiga.find.messagefinder.SelfDrawnListPreference
            android:icon="@drawable/ic_volume_24"
            android:key="@string/alarm_volume_key"
            android:title="@string/alarm_volume_title"
            android:dialogTitle="@string/alarm_volume_title"
            android:dialogMessage="@string/alarm_volume_hint"
            android:entries="@array/alarm_volume_entries"
            android:entryValues="@array/alarm_volume_values"
            android:defaultValue="80"
            android:summary="%s" />

        <!-- modified: 参考系统时钟「逐渐增大音量」，避免深夜一响就满音量 -->
        <SwitchPreferenceCompat
            android:icon="@drawable/ic_volume_24"
            android:key="@string/crescendo_enabled_key"
            android:title="@string/crescendo_enabled_title"
            android:defaultValue="false"
            android:summaryOn="@string/crescendo_enabled_on"
            android:summaryOff="@string/crescendo_enabled_off" />

        <com.saiga.find.messagefinder.SelfDrawnListPreference
            android:icon="@drawable/ic_snooze_24"
            android:key="@string/ring_duration_key"
            android:title="@string/ring_duration_title"
            android:dialogTitle="@string/ring_duration_title"
            android:dialogMessage="@string/ring_duration_hint"
            android:entries="@array/ring_duration_entries"
            android:entryValues="@array/ring_duration_values"
            android:defaultValue="60"
            android:summary="%s" />

        <!-- modified: 参考 Google Clock「音量按钮」设置 -->
        <com.saiga.find.messagefinder.SelfDrawnListPreference
            android:icon="@drawable/ic_tune_24"
            android:key="@string/volume_key_action_key"
            android:title="@string/volume_key_action_title"
            android:dialogTitle="@string/volume_key_action_title"
            android:dialogMessage="@string/volume_key_action_hint"
            android:entries="@array/volume_key_action_entries"
            android:entryValues="@array/volume_key_action_values"
            android:defaultValue="none"
            android:summary="%s" />

        <!-- 【新增 v4.6.0】自定义提醒铃声。放在「试响一次」正上方：
             选完 / 恢复默认后点一下就能听到效果，不用等真实短信。 -->
        <Preference
            android:icon="@drawable/ic_volume_24"
            android:key="@string/custom_ringtone_key"
            android:title="@string/custom_ringtone_title"
            android:summary="@string/custom_ringtone_summary_default"
            android:persistent="false" />

        <!-- modified: v4.5.0 新增「试响一次」。借鉴 SmsForwarder 每个通道都有「测试」按钮、
             reReminder 提供可靠性自检的做法：改完音量 / 时长 / 渐强之后，用户需要立刻
             听到效果，而不是等一条真实短信来验证。点击后固定播 8 秒，不建立会话、不排闹钟。 -->
        <Preference
            android:icon="@drawable/ic_bell_24"
            android:key="@string/preview_alert_key"
            android:title="@string/preview_alert_title"
            android:summary="@string/preview_alert_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <!-- 重复、贪睡与静音 -->
    <!-- modified: 新增分组，把「重复/次数/稍后/静音/匹配规则」收拢 -->
    <PreferenceCategory
        android:title="@string/pref_category_repeat"
        android:key="@string/pref_category_repeat_key">

        <com.saiga.find.messagefinder.SelfDrawnListPreference
            android:icon="@drawable/ic_snooze_24"
            android:key="@string/repeat_interval_key"
            android:title="@string/repeat_interval_title"
            android:dialogTitle="@string/repeat_interval_title"
            android:dialogMessage="@string/repeat_interval_hint"
            android:entries="@array/repeat_interval_entries"
            android:entryValues="@array/repeat_interval_values"
            android:defaultValue="5"
            android:summary="%s" />

        <com.saiga.find.messagefinder.SelfDrawnListPreference
            android:icon="@drawable/ic_repeat_24"
            android:key="@string/max_repeat_key"
            android:title="@string/max_repeat_title"
            android:dialogTitle="@string/max_repeat_title"
            android:dialogMessage="@string/max_repeat_hint"
            android:entries="@array/max_repeat_entries"
            android:entryValues="@array/max_repeat_values"
            android:defaultValue="3"
            android:summary="%s" />

        <!-- modified: 参考系统时钟「贪睡时长」，原先 5 分钟写死在代码里 -->
        <com.saiga.find.messagefinder.SelfDrawnListPreference
            android:icon="@drawable/ic_snooze_24"
            android:key="@string/snooze_minutes_key"
            android:title="@string/snooze_minutes_title"
            android:dialogTitle="@string/snooze_minutes_title"
            android:dialogMessage="@string/snooze_minutes_hint"
            android:entries="@array/snooze_minutes_entries"
            android:entryValues="@array/snooze_minutes_values"
            android:defaultValue="5"
            android:summary="%s" />

        <com.saiga.find.messagefinder.SelfDrawnListPreference
            android:icon="@drawable/ic_moon_24"
            android:key="@string/quiet_hours_key"
            android:title="@string/quiet_hours_title"
            android:dialogTitle="@string/quiet_hours_title"
            android:dialogMessage="@string/quiet_hours_hint"
            android:entries="@array/quiet_hours_entries"
            android:entryValues="@array/quiet_hours_values"
            android:defaultValue="off"
            android:summary="%s" />

        <!-- modified: 借鉴 SmsForwarder 的过滤规则，命中排除词的短信直接忽略 -->
        <EditTextPreference
            android:icon="@drawable/ic_tune_24"
            android:key="@string/exclude_keywords_key"
            android:title="@string/exclude_keywords_title"
            android:dialogTitle="@string/exclude_keywords_title"
            android:dialogMessage="@string/exclude_keywords_hint"
            android:defaultValue="" />

        <SwitchPreferenceCompat
            android:icon="@drawable/ic_tune_24"
            android:key="@string/match_all_key"
            android:title="@string/match_all_title"
            android:defaultValue="false"
            android:summaryOn="@string/match_all_on"
            android:summaryOff="@string/match_all_off" />
    </PreferenceCategory>

    <!-- preference category for experimental features -->
    <PreferenceCategory android:title="@string/app_pref_category1" android:key="@string/app_category_key1">
        <SwitchPreferenceCompat android:title="@string/auto_suggestion_feature"
            android:icon="@drawable/ic_tune_24"
            android:defaultValue="false"
            android:persistent="false"
            android:enabled="true"
            android:key="@string/auto_suggestion_key"
            android:summaryOff="@string/auto_suggestion_off"
            android:summaryOn="@string/auto_suggestion_on"/>
    </PreferenceCategory>
    <!-- preference category for user saved preferences -->
    <PreferenceCategory android:title="@string/app_pref_category2" android:key="@string/app_category_key2">
        <Preference android:title="@string/sms_config"
            android:icon="@drawable/ic_tune_24"
            android:key="@string/sms_config_key"
            android:enabled="false"
            android:shouldDisableView="false"
            android:summary="%s"/>

        <Preference android:title="@string/app_version"
            android:icon="@drawable/ic_bell_24"
            android:key="@string/app_version_key"
            android:enabled="false"
            android:shouldDisableView="false"
            android:summary="@string/current_app_version"/>

        <Preference android:title="@string/hit_log"
            android:icon="@drawable/ic_tune_24"
            android:key="@string/hit_log_key"
            android:persistent="false"
            android:enabled="true"
            android:shouldDisableView="false"
            android:summary="%s"/>

        <Preference android:title="@string/clear_hit_log"
            android:icon="@drawable/ic_tune_24"
            android:key="@string/clear_hit_log_key"
            android:persistent="false"
            android:enabled="true"/>

        <!-- modified: v4.4.0 原「清除配置」是首页的一枚大按钮，极易误触且点下即清空。
             收进设置页的「应用配置」分组，点击后由 SettingsActivity 弹二次确认框，
             只有确认才调用 AppConfig.clear()。persistent=false：它只是操作入口，不存值。 -->
        <Preference android:title="@string/clear_config_title"
            android:icon="@drawable/ic_tune_24"
            android:key="@string/clear_config_key"
            android:persistent="false"
            android:summary="@string/clear_config_summary"/>

        <Preference android:title="@string/app_privacy_policy"
            android:icon="@drawable/ic_shield_24"
            android:enabled="true"
            android:summary="@string/user_guidance">
            <intent android:action="android.intent.action.VIEW"
                android:data="@string/privacy_url"/>
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
